# Copier en .env puis remplir. Ne jamais commiter .env.
# Groq, gratuit : https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter, modeles :free : https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Ollama ne demande aucune cle : ollama pull qwen2.5:7b && ollama pull qwen2.5:1.5b
# Colibri (machine de la classe) : GLM-5.2 pour le grand modele, Ollama pour le petit.
# Sous docker compose, ces adresses sont deja fixees. Hors Docker, mettre l'IP de la machine.
# COLIBRI_URL=http://<machine>:5000/v1/chat/completions
# OLLAMA_URL=http://<machine>:11434/v1/chat/completions
