; Scene du campus de Tessaline, alimentee par pont.py en WebSocket.
config_version=5

[application]
config/name="Ephemere"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.2")

[display]
window/size/viewport_width=1320
window/size/viewport_height=780
window/stretch/mode="canvas_items"
